# Served by the production image (see Dockerfile). SITE_ADDRESS is your domain,
# e.g. play.example.com: Caddy gets and renews its HTTPS certificate automatically.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Player requests are small JSON; refuse anything large before it reaches the API.
	request_body {
		max_size 64KB
	}

	# The API: /api/characters/... reaches dungeon-service as /characters/...
	handle_path /api/* {
		reverse_proxy api:8000 {
			# Send streamed turns (Server-Sent Events) on as they arrive.
			flush_interval -1
		}
	}

	# The built frontend. Unknown paths get index.html so React Router can route them.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Scripts only from this site; fonts from Google Fonts; avatars from Discord.
		# style-src allows inline styles because the animation library sets them.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}
